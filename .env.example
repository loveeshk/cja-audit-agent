# --- Claude API (optional to start; needed for "Explain findings" and "Ask the docs") ---
# You can run the app with NO .env file at all: login is off, the audit uses sample data,
# and the audit checks work. Add the key below to turn on explanations and Q&A.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
PORT=3000

# --- Adobe SSO login (leave blank to run with login OFF) ---
# Login stays OFF until all three Adobe SSO values below are filled in.
# While it is OFF the server only listens on this computer (127.0.0.1).
# From Adobe Developer Console > your project > add "User Authentication (OAuth Web App)" credential
ADOBE_CLIENT_ID=your-adobe-client-id-here
ADOBE_CLIENT_SECRET=your-adobe-client-secret-here
ADOBE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional — only needed if your org uses a different IMS region/host
# ADOBE_IMS_HOST=https://ims-na1.adobelogin.com

# --- Session signing (only needed when login is ON; generated automatically otherwise) ---
# A long random string used to sign session cookies — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# --- Local testing shortcut (optional) ---
# Set to true to skip Adobe SSO entirely while developing — everyone who opens
# the app is treated as a fake "Test User". NEVER set this to true once the
# app is reachable by anyone but you.
# true  = force login off, false = force login on, blank = off until SSO values exist
DISABLE_AUTH=

# --- Data Feed Manager (/feeds) ---
# From Developer Console > your project > Adobe Analytics API > OAuth Server-to-Server credential
ADOBE_S2S_CLIENT_ID=
ADOBE_S2S_CLIENT_SECRET=
ADOBE_S2S_SCOPES=
ADOBE_GLOBAL_COMPANY_ID=

# --- CJA Report Builder (/report) ---
# Needs the Customer Journey Analytics API AND the Adobe Experience Platform
# API both added to the same Server-to-Server credential above (CJA reporting
# sits on top of Experience Platform — without the Platform API attached too,
# you'll get a "User region is missing" error). Scopes must include
# cja.reporting and cja.workspace.
# ADOBE_ORG_ID is the same value as ADOBE_GLOBAL_COMPANY_ID above (format: XXXXXXXX@AdobeOrg)
ADOBE_ORG_ID=

# --- CJA audit data source ---
# AUDIT_SOURCE=mock uses built-in SAMPLE data (no credentials needed, clearly labelled in the UI).
# AUDIT_SOURCE=live reads your real CJA data views and connections (read-only GET requests).
# If unset, the audit uses live data when the Server-to-Server credentials below exist, otherwise sample data.
# AUDIT_SOURCE=mock

# --- Convenience ---
# start.bat / start.sh set OPEN_BROWSER=true so your browser opens when the server is ready.
# OPEN_BROWSER=false

# --- Safety: the only action that changes anything in Adobe ---
# Creating a classic data feed (Data Feeds tab) is OFF unless this is true. It also needs a confirmation each time,
# and every attempt is written to logs/write-audit.jsonl. The CJA Audit tools never write.
# ALLOW_FEED_CREATION=false
# WRITE_AUDIT_LOG=true

# --- Retrieval (RAG) over knowledge.md (the CJA reference notes) ---
# RAG_MODE: 'rag' (default) retrieves relevant chunks of knowledge.md per question.
#           'full' sends the whole notes file every time.
# RAG_MODE=rag
# Number of chunks sent to Claude, and how many are examined before the threshold is applied.
# RAG_TOP_K=4
# RAG_CANDIDATES=8
# Weight of the keyword (BM25) score added to the semantic score. Choose it from the sweep printed by: npm run rag:eval
# RAG_LEX_WEIGHT=0.5
# Minimum similarity score for a chunk to be used. If nothing reaches it, the assistant says the
# notes don't cover the question and does not call Claude. TUNE THIS with: npm run rag:eval
# RAG_MIN_SCORE=0.30
# Chunk size and overlap in words (index is rebuilt automatically when these change).
# RAG_CHUNK_WORDS=180
# RAG_OVERLAP_WORDS=30
# If the embedding model cannot load, answer from the full notes instead of failing (default true).
# RAG_FALLBACK_FULL=true
# Lets a request choose mode rag|full|none, used to produce with/without evidence. Keep false in production.
# RAG_DEBUG=false
# Append a line per question to logs/rag-traces.jsonl (query, chunks used, scores). Set false to disable.
# RAG_TRACE_LOG=true
# Claude settings
# CLAUDE_MODEL=claude-sonnet-5-5
# MAX_TOKENS=1500
